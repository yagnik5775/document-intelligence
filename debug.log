eseparator\\u2014 like here)\\nNationalcharacters\\n\\u000f\\u00f3, \\u00e9,\\u00ed, ...\\n\\u000f\\u00e8, \\u00e0,\\u00ec, ...\\n\\u000f\\u00f4, \\u00ea,...\\n\\u000f\\u00f5, \\u00f1,...\\n\\u000f\\u00f6, \\u00eb,...\\n\\u000f\\u02d9 z\\n\\u000f\\u02db a, \\u02db e\\n\\u000f\\u0142, \\u00f8,\\u00df\\nThere are other ways to do this, see the documentation for inputenc pack-\\nage.\\nReserved characters\", \"page\": 7}, {\"doc_id\": 5, \"text\": \"age.\\nReserved characters\\nSome characters have some special meaning, thus cannot be entered in the usual\\nway.\\n\\u000f$ &% # _{ }\\n\\u000fn\\n\\u000f\\u02dc \\u02c6\", \"page\": 7}, {\"doc_id\": 5, \"text\": \"1.3. LATEX ANDPDFL ATEXCAPABILITIES 9\\nMath\\n\\u000f12,12n, ...\\n\\u000fi1,i2n, ...\\n\\u000f1\\n2,2n\\n23,...\\n\\u000f\\u000b,\\f,\\r,\\n, ...\\n\\u000f!,),\\u0015,6=,2,?, ...\\n\\u000fp\\n2, ...\\n\\u000f2 + 2, ...\\nFormoreexamplesandsymbolsseechapter3of lshort2e.dvi .\\nFonts\\n\\u000fRoman\\n\\u000fEmphasis\\n\\u000fMediumweight\\u2014the default\\n\\u000fBoldface\\n\\u000fUpright\\n\\u000fSlanted\\n\\u000fSansserif\\n\\u000fSMALL CAPS\\n\\u000fTypewriter\\n\\u000fandsizes:\\n\\u2013tiny\\n\\u2013scriptsize\\n\\u2013footnotesize\\n\\u2013small\\n\\u2013normalsize\", \"page\": 8}, {\"doc_id\": 5, \"text\": \"10 CHAPTER1. TEMPLATE\\n\\u2013large\\n\\u2013Large\\n\\u2013LARGE\\n\\u2013huge\\n\\u2013Huge\", \"page\": 9}]"'::jsonb, "faiss_index" = '\'::bytea WHERE "document_processing_uploadedpdf"."id" = 5; args=(10, 'Document.pdf', 'user_10/Document.pdf', datetime.datetime(2025, 9, 4, 9, 2, 54, 229506, tzinfo=datetime.timezone.utc), False, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x000002B402D87BD0>, <psycopg2.extensions.Binary object at 0x000002B4009835D0>, 5); alias=default
